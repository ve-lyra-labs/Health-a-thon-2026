# Root .env.example — all runtime variables for the healthcare system.
# Copy backend/ehr/.env.example → backend/ehr/.env and fill in real values.
# Copy frontend/.env.local.example → frontend/.env.local if needed.
# DO NOT commit any file that contains real secrets.

# === Backend (backend/ehr/.env) ===

ENVIRONMENT=DEV

# Azure Identity
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure FHIR
AZURE_FHIR_URL=

# Azure DICOM
AZURE_DICOM_URL=

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=patient-reports

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure PostgreSQL
DATABASE_URL=
INVENTORY_DATABASE_URL=
RESEARCH_DATABASE_URL=

# DR7 / MedGemma
DIAGNOSTIC_AI_PROVIDER=medgemma
DR7_BASE_URL=https://dr7.ai/api
DR7_API_KEY=
DR7_MEDGEMMA_MODEL=medgemma-4b-it
DR7_REASONING_MODEL=medgemma-27b-it
MEDGEMMA_REQUEST_TIMEOUT=180

# Make.com Webhooks
PATIENT_CHAT_WEBHOOK_URL=
DOCTOR_RESEARCH_WEBHOOK_URL=
DIAGNOSTIC_ASSISTANT_WEBHOOK_URL=

# SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=

# Twilio (patient OTP delivery via SMS) — goes in backend/reg_and_sched/.env,
# NOT backend/ehr/.env, since reg_and_sched/app/core/config.py loads its own
# .env file (see that module's Settings class). TWILIO_FROM_NUMBER can be
# either an E.164 phone number (e.g. +15017122661) or a Messaging Service
# SID (starts with "MG..."). SMS_DEFAULT_COUNTRY_CODE defaults to +91 since
# patient phone numbers are stored as plain 10-digit local numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=+91

# Google Calendar
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/schedule/oauth/callback
GOOGLE_OAUTH_CREDS=

# Research
GOOGLE_CSE_ID=
GOOGLE_API_KEY=

# Auth
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ABDM (Ayushman Bharat Digital Mission) — see backend/ehr/.env.example for
# where to obtain each value (sandbox dashboard, HFR registry, onboarding email).
# MockAbdmClient remains the default until these are filled in and ABDM_ENV
# is deliberately switched away from "sandbox"'s no-op mock behavior.
ABDM_ENV=sandbox
ABDM_USE_REAL_CLIENT=false
ABDM_GATEWAY_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BRIDGE_URL=
ABDM_HFR_FACILITY_ID=
ABDM_HFR_FACILITY_NAME=

# === Frontend (frontend/.env.local) ===
NEXT_PUBLIC_PYTHON_API_URL=http://127.0.0.1:8000/api/v1
